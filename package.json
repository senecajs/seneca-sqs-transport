{
  "name": "@seneca/sqs-transport",
  "version": "0.7.0",
  "main": "dist/SqsTransport.js",
  "type": "commonjs",
  "types": "dist/SqsTransport.d.ts",
  "description": "AWS SQS transport for Seneca messages: the client sends to SQS queues, and listen handles SQS records in AWS Lambda through @seneca/gateway-lambda.",
  "homepage": "https://github.com/senecajs/seneca-sqs-transport",
  "keywords": [
    "seneca",
    "transport",
    "sqs",
    "sqs-transport"
  ],
  "author": "Richard Rodger - richardrodger.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/senecajs/seneca-sqs-transport.git"
  },
  "scripts": {
    "prettier": "prettier --write .",
    "test": "jest --coverage",
    "test-some": "jest -t",
    "test-watch": "jest --coverage --watchAll",
    "watch": "tsc -w -d",
    "build": "tsc -d",
    "doc": "seneca-doc",
    "clean": "rm -rf node_modules yarn.lock package-lock.json dist",
    "reset": "npm run clean && npm i && npm run build && npm test && npm run doc",
    "services:up": "docker compose up -d --wait",
    "services:down": "docker compose down -v"
  },
  "license": "MIT",
  "files": [
    "dist",
    "src/**/*.ts",
    "README.md",
    "CHANGES.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@seneca/doc": "^9.0.0",
    "@seneca/gateway": "^2.0.0",
    "@seneca/gateway-lambda": "^2.0.0",
    "@seneca/transport": "^9.0.0",
    "@types/jest": "^29.5.12",
    "@types/node": "^24.0.0",
    "esbuild": "^0.21.5",
    "esbuild-jest": "^0.5.0",
    "jest": "^29.7.0",
    "prettier": "3.3.1",
    "seneca": "^4.0.0",
    "typescript": "^5.4.5"
  },
  "peerDependencies": {
    "seneca": "^4.0.0",
    "@seneca/gateway": "^2.0.0",
    "@seneca/gateway-lambda": "^2.0.0"
  },
  "peerDependenciesMeta": {
    "@seneca/gateway": {
      "optional": true
    },
    "@seneca/gateway-lambda": {
      "optional": true
    }
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "^3.1147.0"
  }
}
